# Copy this file to ".env" and fill in your own values. Never commit .env.

# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Sandbox PERSONAL account email that receives savings transfers ("your savings pot")
SAVINGS_RECEIVER_EMAIL=

# Sandbox email (the Personal test account) that receives every bill payment
BILLS_RECEIVER_EMAIL=

# Anthropic API key (console.anthropic.com). Without it the app falls back to rule-based classification.
ANTHROPIC_API_KEY=

# Currency used for transfers and display
CURRENCY=USD

# Demo safety limits for the shared sandbox account (in CURRENCY). Optional; these are the defaults.
PAYOUT_MAX_AMOUNT=150
PAYOUT_DAILY_LIMIT=400
PAYOUTS_PER_VISITOR_DAY=5

# Optional: run Claude's analysis on Render Workflows (see workflows.py and render.yaml).
# Leave empty to run the same steps inside this server.
RENDER_API_KEY=
FINAI_WORKFLOW=

# Prepare Claude's sample analysis (English and Spanish) when the server starts. 0 turns it off.
WARM_UP=1

# Set to 1 only on your own computer for auto-reload and error pages
FLASK_DEBUG=
